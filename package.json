{
  "name": "spacedog-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --verbose false",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute spacedog --local --file src/migrations/reset.sql && wrangler d1 execute spacedog --local --file src/migrations/schema.sql",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "postinstall": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.0",
    "hamburger-react": "^2.5.2",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-use": "^17.6.1",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@miniflare/d1": "^2.14.2",
    "@opennextjs/cloudflare": "^1.20.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.1"
  }
}
